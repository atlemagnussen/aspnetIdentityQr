@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<h1>@ViewData["Title"]</h1>

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="field">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Password">Password</label>
        <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.Password"></span>
    </div>
    <div class="field">
        <label asp-for="Input.ConfirmPassword">Confirm password</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button id="registerSubmit" type="submit" class="wa-brand block">Create account</button>
</form>

@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <div class="separator">or register with</div>
    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div class="external-logins">
            @foreach (var provider in Model.ExternalLogins!)
            {
                <wa-button type="submit" name="provider" value="@provider.Name" appearance="outlined"
                    title="Register using your @provider.DisplayName account">
                    <partial name="_ProviderIcon" model="provider.Name" />
                    @provider.DisplayName
                </wa-button>
            }
        </div>
    </form>
}

<p class="below-card">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
