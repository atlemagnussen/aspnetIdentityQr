@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend confirmation";
}

<h1>@ViewData["Title"]</h1>
<p class="lead">Enter your email and we send the confirmation link again.</p>

<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <div class="field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" aria-required="true" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email"></span>
    </div>
    <button type="submit" class="wa-brand block">Resend</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
