@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<h1>@ViewData["Title"]</h1>
<p class="lead">Enter your email and we send you a link to reset it.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email"></span>
    </div>
    <button type="submit" class="wa-brand block">Send reset link</button>
</form>

<p class="below-card"><a asp-page="./Login">Back to log in</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
