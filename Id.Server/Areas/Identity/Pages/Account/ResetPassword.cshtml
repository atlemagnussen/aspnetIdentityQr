@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <input asp-for="Input.Code" type="hidden" />
    <div class="field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.Password"></span>
    </div>
    <div class="field">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button type="submit" class="wa-brand block">Reset password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
