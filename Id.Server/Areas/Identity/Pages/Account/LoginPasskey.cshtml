@page
@model LoginPasskeyModel
@{
    ViewData["Title"] = "No access";
}

<h1>@ViewData["Title"]</h1>
<wa-callout id="external-login-description" variant="warning">
    <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
    You signed in with a <strong>passkey</strong>, but that account has no access here.
</wa-callout>
<p class="below-card"><a asp-page="./Login">Back to log in</a></p>
