@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code";
}

<h1>@ViewData["Title"]</h1>
<p class="lead">
    This login is not remembered until you log in with an authenticator code, or disable 2FA and log in again.
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="field">
        <label asp-for="Input.RecoveryCode"></label>
        <input asp-for="Input.RecoveryCode" autocomplete="off" autofocus />
        <span asp-validation-for="Input.RecoveryCode"></span>
    </div>
    <button type="submit" class="wa-brand block">Log in</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
