@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
}

<h1>@ViewData["Title"]</h1>
<p class="lead">Enter the code from your authenticator app.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <input asp-for="RememberMe" type="hidden" />
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="field">
        <label asp-for="Input.TwoFactorCode"></label>
        <input asp-for="Input.TwoFactorCode" autocomplete="one-time-code" inputmode="numeric" autofocus />
        <span asp-validation-for="Input.TwoFactorCode"></span>
    </div>
    <div class="field-row">
        <label asp-for="Input.RememberMachine">
            <input asp-for="Input.RememberMachine" />
            @Html.DisplayNameFor(m => m.Input.RememberMachine)
        </label>
    </div>
    <button type="submit" class="wa-brand block">Log in</button>
</form>

<p class="below-card">
    No access to your authenticator?
    <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Use a recovery code</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
