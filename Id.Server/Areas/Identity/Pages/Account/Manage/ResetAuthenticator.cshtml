@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Reset authenticator key";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />

<wa-callout variant="warning">
    <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
    <p><strong>Your authenticator app stops working until you set it up again.</strong></p>
    <p>This disables 2FA until you verify the app again. If you don't finish the setup, you can lose access to your account.</p>
</wa-callout>

<form id="reset-authenticator-form" method="post" class="actions">
    <button id="reset-authenticator-button" type="submit" class="wa-danger">Reset authenticator key</button>
    <wa-button href="@Url.Page("./TwoFactorAuthentication")" appearance="plain">Cancel</wa-button>
</form>
