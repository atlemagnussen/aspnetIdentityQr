@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="set-password-form" method="post" class="section">
    <h2>Set a password</h2>
    <p>You have no password yet. Add one so you can log in without an external login.</p>
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="field">
        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword"></span>
    </div>
    <div class="field">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button type="submit" class="wa-brand">Set password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
