@page
@model Disable2faModel
@{
    ViewData["Title"] = "Disable two-factor authentication";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />

<wa-callout variant="warning">
    <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
    <p><strong>This only disables 2FA.</strong></p>
    <p>The key in your authenticator app stays the same. To change it, <a asp-page="./ResetAuthenticator">reset the authenticator key</a>.</p>
</wa-callout>

<form method="post" class="actions">
    <button type="submit" class="wa-danger">Disable 2FA</button>
    <wa-button href="@Url.Page("./TwoFactorAuthentication")" appearance="plain">Cancel</wa-button>
</form>
