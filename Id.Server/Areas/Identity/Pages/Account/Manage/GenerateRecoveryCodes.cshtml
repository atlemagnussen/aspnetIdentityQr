@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "New recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />

<wa-callout variant="warning">
    <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
    <p><strong>Your old recovery codes stop working.</strong></p>
    <p>
        Without your device and recovery codes you lose access to your account. New codes do not change the key in your
        authenticator app; to change it, <a asp-page="./ResetAuthenticator">reset the authenticator key</a>.
    </p>
</wa-callout>

<form method="post" class="actions">
    <button type="submit" class="wa-brand">Generate recovery codes</button>
    <wa-button href="@Url.Page("./TwoFactorAuthentication")" appearance="plain">Cancel</wa-button>
</form>
