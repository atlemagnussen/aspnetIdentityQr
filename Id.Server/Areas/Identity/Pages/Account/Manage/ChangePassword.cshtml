@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="section">
    <h2>Change password</h2>
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="field">
        <label asp-for="Input.OldPassword"></label>
        <input asp-for="Input.OldPassword" autocomplete="current-password" aria-required="true" />
        <span asp-validation-for="Input.OldPassword"></span>
    </div>
    <div class="field">
        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.NewPassword"></span>
    </div>
    <div class="field">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button type="submit" class="wa-brand">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
