@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h1>@ViewData["Title"]</h1>

<form id="download-data" asp-page="DownloadPersonalData" method="post" class="section">
    <h2>Download your data</h2>
    <p>Get a JSON file with the personal data your account holds.</p>
    <button type="submit" class="wa-outlined"><wa-icon name="download"></wa-icon>&nbsp;Download</button>
</form>

<div class="section danger">
    <h2>Delete account</h2>
    <p>This permanently removes your account and its data. You can't undo it.</p>
    <wa-button id="delete" href="@Url.Page("DeletePersonalData")" variant="danger" appearance="outlined">Delete account</wa-button>
</div>
