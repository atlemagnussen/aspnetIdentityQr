@page
@model PasskeysModel
@{
    ViewData["Title"] = "Passkeys";
    ViewData["ActivePage"] = ManageNavPages.Passkeys;
}

<h1>@ViewData["Title"]</h1>

<div class="section">
    <h2>Your passkeys</h2>
    <p>Log in with your fingerprint, face or device PIN instead of a password.</p>
    @if (Model.Keys.Count == 0)
    {
        <p class="empty">No passkeys yet.</p>
    }
    else
    {
        <ul class="item-list">
            @foreach (var key in Model.Keys)
            {
                <li>
                    <span class="item-name"><wa-icon name="fingerprint"></wa-icon>@key.Name</span>
                    <wa-button appearance="plain" size="small" data-credential-id="@key.CredentialId" data-name="@key.Name">
                        <wa-icon name="pen-to-square" label="Rename @key.Name"></wa-icon>
                    </wa-button>
                </li>
            }
        </ul>
    }
    <passkey-create></passkey-create>
</div>

<wa-dialog label="Rename passkey" class="dialog-focus" id="passkeyEditDialog">
    <wa-input autofocus placeholder="New name"></wa-input>
    <wa-button slot="footer" variant="neutral" data-dialog="close">Cancel</wa-button>
    <wa-button slot="footer" variant="brand" id="btnSave">Save</wa-button>
</wa-dialog>

@section Scripts {
    <script type="module" src="~/js/passkeyCreate.js"></script>
    <script type="module" src="~/js/passkeyEdit.js"></script>
}
