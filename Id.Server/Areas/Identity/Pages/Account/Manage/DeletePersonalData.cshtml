@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete account";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h1>@ViewData["Title"]</h1>

<wa-callout variant="danger">
    <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
    <strong>This permanently removes your account and its data. You can't undo it.</strong>
</wa-callout>

<form id="delete-user" method="post" class="section danger">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    @if (Model.RequirePassword)
    {
        <div class="field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.Password"></span>
        </div>
    }
    <div class="actions">
        <button type="submit" class="wa-danger">Delete my account</button>
        <wa-button href="@Url.Page("./PersonalData")" appearance="plain">Cancel</wa-button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
