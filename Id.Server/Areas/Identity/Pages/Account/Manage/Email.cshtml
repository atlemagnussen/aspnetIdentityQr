@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post">
    <div asp-validation-summary="All" role="alert"></div>

    <div class="section">
        <h2>Current email</h2>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" disabled />
        </div>
        @if (Model.IsEmailConfirmed)
        {
            <wa-tag variant="success" size="small"><wa-icon name="circle-check"></wa-icon>&nbsp;Confirmed</wa-tag>
        }
        else
        {
            <wa-callout variant="warning">
                <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
                This email is not confirmed.
            </wa-callout>
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" formnovalidate class="wa-outlined">
                Send verification email
            </button>
        }
    </div>

    <div class="section">
        <h2>Change email</h2>
        <p>We send a confirmation link to the new address. The change applies when you open it.</p>
        <div class="field">
            <label asp-for="Input.NewEmail"></label>
            <input asp-for="Input.NewEmail" autocomplete="email" aria-required="true" placeholder="name@example.com" />
            <span asp-validation-for="Input.NewEmail"></span>
        </div>
        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="wa-brand">Change email</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
