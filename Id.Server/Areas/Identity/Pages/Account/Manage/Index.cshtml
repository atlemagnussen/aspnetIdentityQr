@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="section">
    @* Read only: users can't edit these here (the POST handler for the phone number is not offered). *@
    <div class="field">
        <label for="Username">Username</label>
        <input id="Username" value="@Model.Username" disabled />
    </div>
    <div class="field">
        <label asp-for="Input.PhoneNumber"></label>
        <input asp-for="Input.PhoneNumber" disabled placeholder="Not set" />
    </div>
</div>
