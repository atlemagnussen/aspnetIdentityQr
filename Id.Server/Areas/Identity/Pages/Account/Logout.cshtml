@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<h1>@ViewData["Title"]</h1>
@if (User.Identity?.IsAuthenticated ?? false)
{
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
        <button type="submit" class="wa-brand">Log out</button>
    </form>
}
else
{
    <p class="lead">You have logged out.</p>
    <p class="below-card"><a asp-page="./Login">Log in again</a></p>
}
