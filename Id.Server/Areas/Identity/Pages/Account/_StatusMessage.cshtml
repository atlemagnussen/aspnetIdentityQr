@model string
@* Status after a POST. Text starting with "Error" is shown as an error. *@
@if (!string.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    <wa-callout variant="@(isError ? "danger" : "success")" role="status">
        <wa-icon slot="icon" name="@(isError ? "circle-exclamation" : "circle-check")"></wa-icon>
        @Model
    </wa-callout>
}
