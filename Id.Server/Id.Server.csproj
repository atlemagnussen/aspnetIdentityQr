<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same id as old/AspAuth.Local, so existing local user-secrets keep working -->
    <UserSecretsId>aspnet-AspAuthLocal-48a58dd6-9839-469f-983f-0a4084c579c1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.15" />
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Id.Lib\Id.Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Id.Tests" />
  </ItemGroup>

</Project>
