@using Id.Lib.Entities
@inject SignInManager<ApplicationUser> SignInManager
@{
    // Signed in: app shell with the account menu. Signed out (login, register, reset ...): one centred card.
    var signedIn = SignInManager.IsSignedIn(User);
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en" class="wa-theme-default wa-brand-blue wa-palette-default">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(title) ? "logout.work" : $"{title} - logout.work")</title>
    <link rel="icon" type="image/svg" href="/icon.svg" sizes="32x32">
    <link rel="stylesheet" href="https://static.logout.work/webawesome/3.2.1/dist/styles/themes/default.css" />
    <link rel="stylesheet" href="https://static.logout.work/webawesome/3.2.1/dist/styles/native.css" />
    <link rel="stylesheet" href="~/_content/Id.Lib/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/_content/Id.Lib/shell.js" asp-append-version="true"></script>
</head>
@if (signedIn)
{
    <body class="app-shell">
        <header class="app-topbar">
            <button type="button" class="nav-toggle" aria-controls="app-nav" aria-expanded="false" aria-label="Open menu">
                <wa-icon name="bars"></wa-icon>
            </button>
            <partial name="_Brand" />
        </header>
        <nav id="app-nav" class="app-nav" aria-label="Account">
            <partial name="_Brand" />
            <partial name="_AccountNav" />
        </nav>
        <div class="nav-backdrop" hidden></div>
        <main>
            <div class="page @ViewData["PageClass"]">
                @RenderBody()
            </div>
        </main>
        <partial name="_Footer" />
        <script src="~/js/site.js" asp-append-version="true" type="module"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
}
else
{
    <body class="auth-shell">
        <main>
            <div class="auth-card">
                <partial name="_Brand" />
                @RenderBody()
            </div>
        </main>
        <partial name="_Footer" />
        <script src="~/js/site.js" asp-append-version="true" type="module"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
}
</html>
