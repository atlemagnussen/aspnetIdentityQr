<!DOCTYPE html>
<html lang="en" class="wa-theme-default wa-brand-blue wa-palette-default wa-dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg" href="/icon.svg" sizes="32x32">
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} - User Admin" : "User Admin")</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="navbar-brand" asp-area="" asp-page="/Index">
                <img class="logo" src="/icon.svg" alt="auth logo">
            </a>
            
            <nav class="navbar-nav">
                <a asp-page="/Users">Users</a>
                <a asp-page="/Roles">Roles</a>
                <a asp-page="/Clients">Clients</a>
                <partial name="_LoginPartial" />

            </nav>
        </nav>
    </header>
    <main>
        <section class="centered-content">
            @RenderBody()
        </section>
    </main>
    <footer>
        <span class="build-info">@AspAuth.Lib.Services.BuildInfo.Current.Display</span>
    </footer>
    <script src="~/main.js" asp-append-version="true" type="module"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>